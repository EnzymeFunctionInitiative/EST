timeline.overwrite = true
dag.overwrite = true
report.overwrite = true
nextflow.preview.output = true
nextflow.enable.configProcessNamesValidation = false

executor {
    name = 'slurm'
    queue = 'efi'
    queueSize = 128
}

process {
    executor = 'local'
    cpus = 1
    memory = 5.GB

    withName: all_by_all_blast {
        executor = 'slurm'
        queue = 'efi'
        memory = 2.GB
    }

    withName: blastreduce {
        executor = 'slurm'
        queue = 'efi'
        cpus = 4
        memory = 20.GB
    }

    withName: 'color_ssn|create_gnd|create_gnns|color_gnt_ssn|compute_clusters' {
        executor = 'slurm'
        queue = 'efi'
        memory = 10.GB
    }

    withName: 'filter_blast|create_full_ssn' {
        executor = 'slurm'
        queue = 'efi'
        memory = 16.GB
    }
}

/*
Include a config file containing the default values for workflows
*/ 
includeConfig './default_params.config'

