timeline.overwrite = true
dag.overwrite = true
report.overwrite = true
nextflow.preview.output = true
nextflow.enable.configProcessNamesValidation = false

executor {
    name = 'slurm'
    queue = 'efi'
    queueSize = 128
}

/*
Include a config file containing the default values for workflows
*/
includeConfig './default_params.config'

process {
    executor = 'local'
    cpus = 1
    memory = 5.GB

    withLabel: 'APP_cd_hit' {
        executor = 'slurm'
        queue = 'efi'
        cpus = 2
        memory = params.cdhit_memory_limit
    }

    withLabel: 'TASK_create_ssn' {
        executor = 'slurm'
        queue = 'efi'
        cpus = 1
        memory = '20 GB'
        scratch = params.compute_local_storage
    }

    withName: all_by_all_blast {
        executor = 'slurm'
        queue = 'efi'
        memory = 2.GB
    }

    withName: blastreduce {
        executor = 'slurm'
        queue = 'efi'
        cpus = 4
        memory = 20.GB
    }

    withName: 'color_ssn|create_gnd|create_gnns|color_gnt_ssn|compute_clusters' {
        executor = 'slurm'
        queue = 'efi'
        memory = 10.GB
    }

    withName: 'filter_blast|create_full_ssn' {
        executor = 'slurm'
        queue = 'efi'
        memory = 16.GB
    }

    withLabel: muscle_align {
        executor = 'slurm'
        cpus = 1
    }
}

